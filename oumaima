<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>W3PRO // Test-First & Scientific Study Studio</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&family=JetBrains+Mono:wght@400;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg-dark: #0d1117;
      --bg-sidebar: #161b22;
      --bg-card: #1c2128;
      --bg-code: #090c10;
      --border: #30363d;
      --text: #e6edf3;
      --muted: #8b949e;
      --w3-green: #04aa6d;
      --w3-green-hover: #059862;
      --accent-blue: #58a6ff;
      --accent-warn: #d29922;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      background: var(--bg-dark);
      color: var(--text);
      font-family: 'Cairo', 'Plus Jakarta Sans', sans-serif;
      line-height: 1.75;
    }

    body[data-latin="true"] {
      font-family: 'Plus Jakarta Sans', 'Cairo', sans-serif;
    }

    .mono {
      font-family: 'JetBrains Mono', monospace;
      direction: ltr;
      text-align: left;
    }

    .w3-topbar {
      background: #010409;
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .w3-logo {
      background: var(--w3-green);
      color: #fff;
      font-weight: 800;
      padding: 4px 12px;
      border-radius: 6px;
      font-size: 0.95rem;
    }

    .subject-bar {
      background: #161b22;
      border-bottom: 1px solid var(--border);
      overflow-x: auto;
      white-space: nowrap;
    }

    .subj-tab {
      background: transparent;
      border: none;
      color: var(--text);
      padding: 10px 18px;
      font-weight: 700;
      font-size: 0.85rem;
      cursor: pointer;
    }

    .subj-tab:hover { background: #21262d; }
    .subj-tab.active { background: var(--w3-green); color: #fff; }

    .w3-sidebar {
      background: var(--bg-sidebar);
      border-inline-end: 1px solid var(--border);
      min-height: calc(100vh - 105px);
    }

    .lesson-link {
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%;
      text-align: start;
      background: transparent;
      border: none;
      color: var(--text);
      padding: 10px 16px;
      font-size: 0.9rem;
      cursor: pointer;
      border-bottom: 1px solid rgba(48, 54, 61, 0.45);
    }

    .lesson-link:hover { background: #21262d; }
    .lesson-link.active { background: var(--w3-green); color: #fff; font-weight: 700; }

    .w3-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 18px;
      margin: 16px 0;
    }

    .w3-code-block {
      background: var(--bg-code);
      border-inline-start: 4px solid var(--w3-green);
      padding: 13px;
      border-radius: 6px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.88rem;
      color: #e6edf3;
      direction: ltr;
      text-align: left;
      white-space: pre-wrap;
    }

    .btn-w3 {
      background: var(--w3-green);
      color: #fff;
      border: none;
      font-weight: 700;
      padding: 8px 16px;
      border-radius: 6px;
    }

    .btn-w3:hover { background: var(--w3-green-hover); color: #fff; }

    .tryit-editor {
      width: 100%;
      height: 210px;
      background: var(--bg-code);
      color: #f0f6fc;
      border: none;
      padding: 13px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.88rem;
      direction: ltr;
      text-align: left;
    }

    .tryit-editor:focus { outline: none; }

    .tryit-preview {
      width: 100%;
      height: 210px;
      background: #ffffff;
      color: #111;
      border: none;
    }

    .tryit-console {
      width: 100%;
      height: 210px;
      background: #010409;
      color: #3fb950;
      padding: 13px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.86rem;
      direction: ltr;
      text-align: left;
      white-space: pre-wrap;
      overflow: auto;
    }

    .w3-note {
      background: rgba(88, 166, 255, 0.1);
      border-inline-start: 4px solid var(--accent-blue);
      padding: 12px 16px;
      border-radius: 6px;
    }

    .answer-drawer {
      background: #090c10;
      border: 1px dashed var(--accent-warn);
      border-radius: 8px;
      padding: 14px;
      margin-top: 12px;
    }

    .lang-btn.active {
      background: var(--w3-green) !important;
      border-color: var(--w3-green) !important;
      color: #fff !important;
    }

    .muted { color: var(--muted); }
  </style>
</head>
<body>

  <header class="w3-topbar py-2 px-3">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
      <div class="d-flex align-items-center gap-3">
        <span class="w3-logo">W3PRO</span>
        <span class="small muted d-none d-md-inline" id="headerSub">Test-First & Scientific Study Studio</span>
      </div>

      <div class="d-flex flex-wrap align-items-center gap-2">
        <span class="badge text-bg-dark border border-secondary px-2 py-1 mono">XP: <span id="xpVal" style="color:#3fb950;">0</span></span>

        <div class="d-flex align-items-center gap-1 border border-secondary rounded px-2 py-1 small">
          <span class="muted" id="focusLbl">Focus</span>
          <strong class="mono" id="clockTxt">25:00</strong>
          <button class="btn btn-sm btn-outline-light py-0 px-1" id="timerBtn">▶</button>
        </div>

        <div class="btn-group btn-group-sm">
          <button class="btn btn-outline-secondary lang-btn active" data-lang="ar">العربية</button>
          <button class="btn btn-outline-secondary lang-btn" data-lang="fr">FR</button>
          <button class="btn btn-outline-secondary lang-btn" data-lang="en">EN</button>
        </div>
      </div>
    </div>
  </header>

  <nav class="subject-bar px-2" id="subjectBar"></nav>

  <div class="container-fluid">
    <div class="row">
      <aside class="col-md-3 col-lg-2 p-0 w3-sidebar">
        <div class="p-3 fw-bold small border-bottom border-secondary" id="sidebarTitle">HTML Tutorial</div>
        <div id="lessonMenu"></div>
      </aside>

      <main class="col-md-9 col-lg-10 p-3 p-md-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
          <h3 class="fw-bold m-0" id="lessonTitle">...</h3>
          <div class="d-flex gap-2">
            <button class="btn btn-sm btn-outline-light" id="prevBtn">❮ Previous</button>
            <button class="btn btn-sm btn-w3" id="nextBtn">Next ❯</button>
          </div>
        </div>

        <!-- Feynman Rule + Scientific Study Tip -->
        <div class="w3-note mb-4">
          <div class="fw-bold small mb-1" style="color: var(--accent-blue);" id="feynmanLbl">قاعدة الفهم السريع (Feynman Rule)</div>
          <div id="feynmanTxt"></div>
        </div>

        <!-- Usage & Rendering -->
        <div class="row g-3 mb-4">
          <div class="col-md-6">
            <div class="p-3 rounded border border-secondary bg-dark h-100">
              <div class="fw-bold small mb-1" style="color: var(--accent-blue);" id="useHeading">كيف يُستخدم</div>
              <div class="small" id="useBody"></div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="p-3 rounded border border-secondary bg-dark h-100">
              <div class="fw-bold small mb-1" style="color: #3fb950;" id="renderHeading">كيف يظهر</div>
              <div class="small" id="renderBody"></div>
            </div>
          </div>
        </div>

        <!-- Example + Try It Yourself -->
        <div class="w3-card">
          <h5 class="fw-bold mb-2" id="exampleHeading">Example</h5>
          <pre class="w3-code-block mb-3" id="exampleCode"></pre>

          <div class="border border-secondary rounded overflow-hidden">
            <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom border-secondary bg-dark">
              <strong class="small mono">Try it Yourself</strong>
              <button class="btn btn-sm btn-w3" id="runTryItBtn">Run ❯</button>
            </div>
            <div class="row g-0">
              <div class="col-lg-6 border-end border-secondary">
                <textarea id="tryItEditor" class="tryit-editor" spellcheck="false"></textarea>
              </div>
              <div class="col-lg-6">
                <iframe id="liveIframe" class="tryit-preview" title="Preview"></iframe>
                <div id="liveConsole" class="tryit-console d-none"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- USER-FIRST TEST (NO SOLUTION SPOILER UNTIL ATTEMPT OR EXPLICIT REQUEST) -->
        <div class="w3-card">
          <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
            <h5 class="fw-bold m-0" style="color: var(--accent-warn);" id="testHeading">اختبار التطبيق (أجب أولاً بنفسك)</h5>
            <span class="small muted mono" id="attemptBadge">ATTEMPTS: 0</span>
          </div>

          <p class="small mb-2" id="testPrompt"></p>
          <textarea id="testEditor" class="w3-code-block w-100 mb-3" style="min-height: 110px; border: 1px solid var(--border);" spellcheck="false"></textarea>

          <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex gap-2">
              <button class="btn btn-w3" id="submitTestBtn">Submit Answer</button>
              <button class="btn btn-sm btn-outline-warning" id="revealAnswerBtn">Reveal Answer & Rule</button>
            </div>
            <button class="btn btn-sm btn-outline-light" id="dlSummaryBtn">⬇ Download Full Summary (.md)</button>
          </div>

          <div class="mt-2 small fw-bold" id="testFeedback"></div>

          <!-- Hidden until user submits or clicks Reveal Answer -->
          <div id="answerDrawer" class="answer-drawer d-none">
            <div class="fw-bold small mb-1" style="color: var(--accent-warn);" id="solutionTitle">الحل وشرح القاعدة</div>
            <pre class="w3-code-block mb-2" id="solutionCode"></pre>
            <div class="small" id="solutionRule"></div>
          </div>
        </div>

        <!-- Scientific Study Methods Box -->
        <div class="w3-card">
          <h6 class="fw-bold mb-2" id="sciTitle">تقنيات علمية للتركيز والحفظ وتسهيل الدراسة</h6>
          <div class="row g-2 small muted" id="sciCards"></div>
        </div>

      </main>
    </div>
  </div>

