              feynman: "A class is a blueprint; __init__ sets instance state via self.",
              use: "Define class with def __init__(self, ...):.",
              render: "Each object stores its own attributes via self.",
              testPrompt: "Create class Goal: with def __init__(self, title): setting self.title = title.",
              ruleExplain: "Rule: instance methods take self as their first parameter."
            },
            example: `class Goal:\n    def __init__(self, title):\n        self.title = title\n\ng = Goal("Finish module")\nprint(g.title)`,
            sampleOutput: `Finish module`,
            starter: `class Goal:\n    def __init__(self, title):\n        pass`,
            solution: `class Goal:\n    def __init__(self, title):\n        self.title = title`,
            check: (c) => c.includes("class Goal") && c.includes("def __init__") && c.includes("self.title = title")
          }
        ]
      }
    ];

    const UI = {
      ar: {
        dir: "rtl", latin: false,
        headerSub: "اختبر نفسك أولاً + تقنيات علمية للتركيز والحفظ",
        focusLbl: "تركيز",
        prev: "❮ السابق", next: "التالي ❯",
        feynmanLbl: "قاعدة الفهم السريع (Feynman Rule)",
        useH: "كيف يُستخدم", renderH: "كيف يظهر",
        exH: "مثال تطبيقي", run: "تشغيل ❯",
        testH: "اختبار التطبيق (أجب أولاً بنفسك)",
        submit: "إرسال الإجابة", reveal: "إظهار الحل والقاعدة",
        dlMd: "⬇ تحميل ملخص الدروس (.md)",
        solTitle: "الحل النموذجي وشرح القاعدة",
        mustTry: "اكتب محاولتك أولاً في المربع قبل إرسال الإجابة.",
        ok: "✔ إجابة صحيحة! حصلت على +50 XP",
        err: "✘ ليست مطابقة بعد — راجع المطلوب أو اطلب إظهار الحل.",
        sciTitle: "تقنيات علمية للتركيز ورفع الإنتاجية وحفظ القواعد",
        sci: [
          ["Active Recall", "اختبر ذاكرتك قبل النظر للحل لترسيخ المعلومة."],
          ["Pomodoro 25m", "ركّز 25 دقيقة على مهمة واحدة لتقليل التشتت."],
          ["Feynman 1-Line", "لخّص القاعدة بجملة بسيطة من فهمك الخاص."],
          ["Spaced Review", "أعد اختبار نفس القاعدة بعد فترة قصيرة لتثبيتها."]
        ]
      },
      fr: {
        dir: "ltr", latin: true,
        headerSub: "Test d'abord + Méthodes scientifiques d'étude",
        focusLbl: "Focus",
        prev: "❮ Précédent", next: "Suivant ❯",
        feynmanLbl: "Règle simple (Feynman)",
        useH: "Comment l'utiliser", renderH: "Comment ça s'affiche",
        exH: "Exemple", run: "Exécuter ❯",
        testH: "Test pratique (Réponds d'abord toi-même)",
        submit: "Valider ma réponse", reveal: "Afficher solution & règle",
        dlMd: "⬇ Télécharger le résumé (.md)",
        solTitle: "Solution & Explication de la règle",
        mustTry: "Écris d'abord ta tentative avant de valider.",
        ok: "✔ Correct ! +50 XP",
        err: "✘ Pas encore validé — réessaie ou affiche la solution.",
        sciTitle: "Méthodes scientifiques : Focus, Productivité & Rétention",
        sci: [
          ["Active Recall", "Teste-toi avant de voir la réponse."],
          ["Pomodoro 25m", "25 min sur une seule tâche sans dispersion."],
          ["Feynman 1-Line", "Explique la règle en une phrase claire."],
          ["Spaced Review", "Revois la règle à intervalles pour mémoriser."]
        ]
      },
      en: {
        dir: "ltr", latin: true,
        headerSub: "Test-First + Science-Backed Focus & Retention",
        focusLbl: "Focus",
        prev: "❮ Previous", next: "Next ❯",
        feynmanLbl: "Feynman One-Line Rule",
        useH: "How It Is Used", renderH: "How It Renders",
        exH: "Example", run: "Run ❯",
        testH: "Practice Test (Attempt First)",
        submit: "Submit Answer", reveal: "Reveal Answer & Rule",
        dlMd: "⬇ Download Full Summary (.md)",
        solTitle: "Reference Answer & Rule Breakdown",
        mustTry: "Write your own attempt first before submitting.",
        ok: "✔ Correct! +50 XP",
        err: "✘ Not matching yet — try again or reveal the answer.",
        sciTitle: "Scientific Techniques for Focus, Productivity & Retention",
        sci: [
          ["Active Recall", "Retrieve from memory before viewing the answer."],
          ["Pomodoro 25m", "25-minute single-task blocks reduce mental fatigue."],
          ["Feynman 1-Line", "State the rule plainly in your own words."],
          ["Spaced Review", "Re-test rules later to lock long-term memory."]
        ]
      }
    };

    const state = {
      lang: "ar",
      cIdx: 0,
      lIdx: 0,
      xp: 0,
      attempts: {},
      done: {},
      sec: 25 * 60,
      running: false
    };

    let timerInt = null;
    const curCourse = () => COURSES[state.cIdx];
    const curLesson = () => curCourse().lessons[state.lIdx];

    function runLive() {
      const course = curCourse();
      const lesson = curLesson();
      const code = document.getElementById("tryItEditor").value;
      const iframe = document.getElementById("liveIframe");
      const consoleBox = document.getElementById("liveConsole");

      if (course.type === "web") {
        iframe.classList.remove("d-none");
        consoleBox.classList.add("d-none");
        iframe.srcdoc = code;
      } else {
        iframe.classList.add("d-none");
        consoleBox.classList.remove("d-none");
        const prints = [...code.matchAll(/print\((["'])(.*?)\1\)/g)].map(m => m[2]);
        consoleBox.textContent = prints.length ? prints.join("\n") : (lesson.sampleOutput || ">>> Executed (0 errors)");
      }
    }

    function applyLang() {
      const u = UI[state.lang];
      document.documentElement.lang = state.lang;
      document.documentElement.dir = u.dir;
      document.body.dataset.latin = u.latin ? "true" : "false";

      document.getElementById("headerSub").textContent = u.headerSub;
      document.getElementById("focusLbl").textContent = u.focusLbl;
      document.getElementById("prevBtn").textContent = u.prev;
      document.getElementById("nextBtn").textContent = u.next;
      document.getElementById("feynmanLbl").textContent = u.feynmanLbl;
      document.getElementById("useHeading").textContent = u.useH;
      document.getElementById("renderHeading").textContent = u.renderH;
      document.getElementById("exampleHeading").textContent = u.exH;
      document.getElementById("runTryItBtn").textContent = u.run;
      document.getElementById("testHeading").textContent = u.testH;
      document.getElementById("submitTestBtn").textContent = u.submit;
      document.getElementById("revealAnswerBtn").textContent = u.reveal;
      document.getElementById("dlSummaryBtn").textContent = u.dlMd;
      document.getElementById("solutionTitle").textContent = u.solTitle;
      document.getElementById("sciTitle").textContent = u.sciTitle;

      document.getElementById("sciCards").innerHTML = u.sci.map(([k, v]) => `
        <div class="col-sm-6 col-lg-3">
          <div class="p-2 rounded border border-secondary bg-dark h-100">
            <strong class="d-block text-light">${k}</strong>
            <span>${v}</span>
          </div>
        </div>
      `).join("");

      document.querySelectorAll(".lang-btn").forEach(b => b.classList.toggle("active", b.dataset.lang === state.lang));
      renderAll();
    }

    function renderAll() {
      const course = curCourse();
      const lesson = curLesson();
      const d = lesson[state.lang];

      document.getElementById("xpVal").textContent = state.xp;

      const sBar = document.getElementById("subjectBar");
      sBar.innerHTML = "";
      COURSES.forEach((c, i) => {
        const b = document.createElement("button");
        b.type = "button";
        b.className = `subj-tab ${i === state.cIdx ? "active" : ""}`;
        b.textContent = c.label;
        b.addEventListener("click", () => {
          state.cIdx = i;
          state.lIdx = 0;
          renderAll();
        });
        sBar.appendChild(b);
      });

      document.getElementById("sidebarTitle").textContent = `${course.label} Tutorial`;
      const menu = document.getElementById("lessonMenu");
      menu.innerHTML = "";
      course.lessons.forEach((l, i) => {
        const b = document.createElement("button");
        b.type = "button";
        b.className = `lesson-link ${i === state.lIdx ? "active" : ""}`;
        b.innerHTML = `<span>${l[state.lang].menu}</span><span>${state.done[l.id] ? "✓" : ""}</span>`;
        b.addEventListener("click", () => {
          state.lIdx = i;
          renderAll();
        });
        menu.appendChild(b);
      });

      document.getElementById("lessonTitle").textContent = d.title;
      document.getElementById("feynmanTxt").textContent = d.feynman;
      document.getElementById("useBody").textContent = d.use;
      document.getElementById("renderBody").textContent = d.render;
      document.getElementById("exampleCode").textContent = lesson.example;

      document.getElementById("tryItEditor").value = lesson.example;
      runLive();

      document.getElementById("testPrompt").textContent = d.testPrompt;
      document.getElementById("testEditor").value = lesson.starter;
      document.getElementById("testFeedback").textContent = "";
      document.getElementById("attemptBadge").textContent = `ATTEMPTS: ${state.attempts[lesson.id] || 0}`;

      // Keep solution hidden until user clicks reveal
      document.getElementById("answerDrawer").classList.add("d-none");
      document.getElementById("solutionCode").textContent = lesson.solution;
      document.getElementById("solutionRule").textContent = d.ruleExplain;
    }

    document.querySelectorAll(".lang-btn").forEach(b => {
      b.addEventListener("click", () => {
        state.lang = b.dataset.lang;
        applyLang();
      });
    });

    document.getElementById("runTryItBtn").addEventListener("click", runLive);

    document.getElementById("prevBtn").addEventListener("click", () => {
      if (state.lIdx > 0) state.lIdx--;
      else if (state.cIdx > 0) {
        state.cIdx--;
        state.lIdx = curCourse().lessons.length - 1;
      }
      renderAll();
    });

    document.getElementById("nextBtn").addEventListener("click", () => {
      if (state.lIdx < curCourse().lessons.length - 1) state.lIdx++;
      else if (state.cIdx < COURSES.length - 1) {
        state.cIdx++;
        state.lIdx = 0;
      }
      renderAll();
    });

    document.getElementById("submitTestBtn").addEventListener("click", () => {
      const lesson = curLesson();
      const d = lesson[state.lang];
      const u = UI[state.lang];
      const val = document.getElementById("testEditor").value;
      const fb = document.getElementById("testFeedback");

      if (val.trim() === lesson.starter.trim()) {
        fb.textContent = u.mustTry;
        fb.style.color = "#d29922";
        return;
      }

      state.attempts[lesson.id] = (state.attempts[lesson.id] || 0) + 1;
      document.getElementById("attemptBadge").textContent = `ATTEMPTS: ${state.attempts[lesson.id]}`;

      if (lesson.check(val)) {
        if (!state.done[lesson.id]) {
          state.done[lesson.id] = true;
          state.xp += 50;
          document.getElementById("xpVal").textContent = state.xp;
        }
        fb.textContent = u.ok;
        fb.style.color = "#3fb950";
        document.getElementById("answerDrawer").classList.remove("d-none");
        document.getElementById("solutionCode").textContent = lesson.solution;
        document.getElementById("solutionRule").textContent = d.ruleExplain;
      } else {
        fb.textContent = u.err;
        fb.style.color = "#d29922";
      }
    });

    document.getElementById("revealAnswerBtn").addEventListener("click", () => {
      const lesson = curLesson();
      const d = lesson[state.lang];
      document.getElementById("answerDrawer").classList.remove("d-none");
      document.getElementById("solutionCode").textContent = lesson.solution;
      document.getElementById("solutionRule").textContent = d.ruleExplain;
    });

    document.getElementById("dlSummaryBtn").addEventListener("click", () => {
      const lines = [`# W3PRO Study Summary (${state.lang.toUpperCase()})`];
      COURSES.forEach(c => {
        lines.push(`\n## ${c.label}`);
        c.lessons.forEach(l => {
          const d = l[state.lang];
          lines.push(`### ${d.title}\n- Rule: ${d.feynman}\n- Usage: ${d.use}\n- Rendering: ${d.render}\n- Checkpoint Rule: ${d.ruleExplain}`);
        });
      });
      const blob = new Blob([lines.join("\n")], { type: "text/markdown;charset=utf-8" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = `w3pro-study-summary-${state.lang}.md`;
      a.click();
      URL.revokeObjectURL(url);
    });

    document.getElementById("timerBtn").addEventListener("click", () => {
      state.running = !state.running;
      document.getElementById("timerBtn").textContent = state.running ? "❚❚" : "▶";
      if (state.running) {
        timerInt = setInterval(() => {
          if (state.sec > 0) {
            state.sec--;
            const m = String(Math.floor(state.sec / 60)).padStart(2, "0");
            const s = String(state.sec % 60).padStart(2, "0");
            document.getElementById("clockTxt").textContent = `${m}:${s}`;
          } else {
            state.running = false;
            clearInterval(timerInt);
          }
        }, 1000);
      } else {
        clearInterval(timerInt);
      }
    });

    applyLang();
  </script>
</body>
</html>
